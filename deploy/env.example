# JaaS application configuration
# Copy this to /opt/jaas-app/env (or deploy/env for Docker) and fill in values.
# Secrets can be files: NAME_FILE=/path instead of NAME=value.

PUBLIC_ORIGIN=https://mtg.example.com
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_FILE=/opt/jaas-app/jaas-api-key.pk
JAAS_WEBHOOK_SECRET_FILE=/opt/jaas-app/jaas-webhook-secret
# First start only; at least 14 characters, changed at first login.
ADMIN_INITIAL_PASSWORD_FILE=/opt/jaas-app/admin-initial-password
LISTEN_ADDR=:8370
DB_PATH=/opt/jaas-app/jaas.db
# DISPLAY_TIMEZONE=UTC
# MAX_MEETING_HOURS=4
# TRANSCRIPT_RETENTION_MONTHS=
# MINUTES_RETENTION_MONTHS=

# Optional AI minutes (leave unset to keep the app as video + JaaS transcripts)
# OPENAI_API_KEY_FILE=/opt/jaas-app/openai-api-key
# OPENAI_MODEL=
# MINUTES_LANGUAGE=English
# TRANSCRIBE_LANGUAGE=en

# Optional e-mail (host notices and approved copies)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD_FILE=/opt/jaas-app/smtp-password
# MAIL_FROM=meetings@example.com
# MAIL_REPLY_TO=
# PRIVACY_URL=https://example.com/privacy

# Optional Cloudflare Access in front of /admin
# CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# CF_ACCESS_AUD=
# CF_ACCESS_ALLOWED_DOMAINS=example.com
# ADMIN_EMAILS=admin@example.com

# JaaS application configuration
# Copy this to /opt/jaas-app/env (or deploy/env for Docker) and fill in values

JAAS_APP_ID=
JAAS_API_KEY_ID=

# Supply the RSA private key as a file path, or inline with JAAS_API_KEY when
# the host only offers environment secrets.
JAAS_API_KEY_PATH=/opt/jaas-app/jaas-api-key.pk
# JAAS_API_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
ADMIN_PASSWORD=
SESSION_SECRET=
LISTEN_ADDR=:8370
DB_PATH=/opt/jaas-app/jaas.db
